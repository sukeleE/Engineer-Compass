{
  "name": "engineer-compass-miniprogram",
  "version": "0.1.0",
  "private": true,
  "description": "Engineer-Compass 工科竞赛导航微信小程序（uni-app + Vue3 + Vite，与 H5 版共用同一 Express 后端）",
