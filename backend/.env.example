# Engineer-Compass 后端环境变量模板
# 用法：复制本文件为 .env 并填写真实值（.env 禁止提交到 git / 发给他人）
# 上线必配：DEEPSEEK_API_KEY（否则线上用户全部 AI 功能不可用）

# ===== AI（必配）=====
# DeepSeek 开放平台申请：https://platform.deepseek.com → 充值 → 创建 API Key
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
DEEPSEEK_MODEL=deepseek-chat

# ===== 票据图片视觉识别（报销模块「传图识别预填」；不配则识别接口返回 502 提示，其余功能不受影响）=====
# 智谱开放平台申请：https://open.bigmodel.cn → API Keys（形如 id.secret）
# 模型二选一：glm-4.6v-flash（免费、支持 base64，但有限流，429 频发）/ glm-5.3-flash（付费 flash，
#   票据简单图实测 7~19s、约厘钱一次，线上建议用它；老 glm-4v-flash 只收图片 URL 不支持 base64，勿用）
# 图片建议 <10MB（前端已压缩 ≤1600px）
VISION_API_KEY=xxxxxxxx.xxxxxxxx
VISION_MODEL=glm-5.3-flash
# VISION_BASE_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions

# ===== PDF 票据 OCR（可选，不配也能跑）=====
# PDF 识别链路：有文字层 → 文本模型；字体未嵌入/扫描件 → 先走 GLM-OCR（约 2s、~0.001 元/次），
#   再兜底转图走上面的视觉模型。OCR 与视觉共用 VISION_API_KEY（同一智谱账号），一般无需额外配置。
# OCR_MODEL=glm-ocr
# OCR_BASE_URL=https://open.bigmodel.cn/api/paas/v4/layout_parsing

# ===== 服务 =====
PORT=3000
# 数据库文件路径（默认 backend/data/compass.db；部署时建议显式指定，便于备份）
# DB_PATH=/opt/compass/backend/data/compass.db

# ===== 邮件（邮箱验证码登录，建议配）=====
# 未配置时验证码直接返回给前端（仅适合开发联调，上线必须配置真 SMTP）
# QQ 邮箱：设置 → 账号 → 开启 SMTP 服务 → 生成授权码（不是登录密码）
# SMTP_HOST=smtp.qq.com
# SMTP_PORT=465
# SMTP_USER=yourname@qq.com
# SMTP_PASS=xxxxxxxxxxxxxxxx
# SMTP_FROM=Engineer-Compass <yourname@qq.com>

# ===== 资源分享·项目文件夹 =====
# 单帖文件夹上限（字节，默认 200MB）与单用户分享空间总额（默认 2GB）
# SHARE_FOLDER_MAX=209715200
# SHARE_QUOTA=2147483648

# ===== Gitee 仓库文件树（可选）=====
# 只读公开仓库的文件清单来展示，**不配也能用**：匿名约 60 次/小时/IP，够小站用。
# 配了只是把配额提到账号级，人多/拉得勤时再配。令牌别提交到仓库。
# GITEE_ACCESS_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 私有化部署 / 走代理时才动下面这行（默认 https://gitee.com/api/v5）
# GITEE_BASE_URL=https://gitee.com/api/v5

# ===== 反馈 =====
# 用户反馈邮件收件人（默认即管理员邮箱 3209646785@qq.com，可不配）
# FEEDBACK_TO=3209646785@qq.com
